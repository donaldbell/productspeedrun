# Copy this file to .env and fill in whichever keys you have.
# .env is ignored by git, so your keys stay on this computer.

# Google Gemini image generation (paid per image)
GEMINI_API_KEY=
# The image model to use. Check Google's docs for the current name.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# OpenAI image generation (paid per image)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Port for the local console (default 4321)
# PORT=4321
