# Watch: ESP32-C6-MINI-1-N4 (4 MB flash), 150 mAh cell: every mA matters
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y
CONFIG_FREERTOS_HZ=1000
# Light sleep between radio wake windows (esp_pm in main.c) and ESP-NOW power save while not connected to an AP
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=y
# Logs on USB Serial/JTAG (the jig's TP2/TP3) as well as UART0
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
